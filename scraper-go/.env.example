# Database — Supabase transaction pooler (port 6543)
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres

# Shared bearer token — MUST match SCRAPER_SERVICE_TOKEN in the root .env
SCRAPER_SERVICE_TOKEN=<random-shared-token>

# Service config
LISTEN_ADDR=:8080
PGX_MAX_CONNS=4
REDIS_URL=redis://localhost:6379/0
