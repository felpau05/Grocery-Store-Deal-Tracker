# Environment variables / secrets
.env
.env.*

# Do not ignore .env.example so it can be used as an example for github
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache/build files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python packaging/build output
build/
dist/
*.egg-info/

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
*:Zone.Identifier

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Node/frontend later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/

# Next.js build output
.next/
frontend/.next/

# Generated by next build / tsc — regenerated on every build, so tracking
# them only produces diff churn (next-env.d.ts flips between the dev and
# prod types path depending on which command ran last).
frontend/next-env.d.ts
*.tsbuildinfo

# Docker/local override files
docker-compose.override.yml

# Temporary files
tmp/
temp/
*.tmp

# Testing Stuff
backend/test_outputs/

# Large ML models and training data (>100MB, excluded from git)
backend/training_data/
backend/classifier/model*.bin
backend/classifier/model*.joblib

# Markdown files (except README)
*.md
!README.md
*storybook.log
storybook-static

# WSL drops these alongside files copied in from Windows
*:Zone.Identifier
